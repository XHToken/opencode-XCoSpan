{
  "name": "@iflytekopensource/opencode-xcospan",
  "version": "0.1.0",
  "description": "Reviewed local-cloud collaboration for OpenCode V2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XHToken/opencode-XCoSpan.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "agent",
    "privacy",
    "cloud-collaboration"
  ],
  "homepage": "https://github.com/XHToken/opencode-XCoSpan#readme",
  "bugs": "https://github.com/XHToken/opencode-XCoSpan/issues",
  "packageManager": "bun@1.4.3",
  "exports": {
    ".": "./server.ts",
    "./tui": "./dist/tui.js",
    "./rpc": "./rpc.ts"
  },
  "files": [
    "src/*.ts",
    "dist/tui.js",
    "server.ts",
    "tui.tsx",
    "rpc.ts",
    "skills/materials/SKILL.md",
    "skills/materials/extract.ts",
    "README.md",
    "docs/*.md",
    "docs/assets/readme/*.png",
    "CONTRIBUTING.md",
    "test/README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "setup": "bun run build && bun scripts/setup.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:package": "bun scripts/test-package.ts",
    "test:integration": "bun run build && bun test test/integration --timeout 120000",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "test:live": "bun run build && bun test test/live --timeout 1860000",
    "check": "bun run typecheck && bun run lint && bun run test",
    "prepack": "bun run typecheck && bun run build"
  },
  "dependencies": {
    "@opencode/ai": "2.0.27",
    "@opencode/plugin": "2.0.27",
    "@xberg-io/xberg": "1.3.10",
    "effect": "4.0.1",
    "got": "16.1.0",
    "jsonc-parser": "^3.3.1",
    "request-filtering-agent": "3.2.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "1.0.0",
    "@opencode/client": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "@types/semver": "7.7.1",
    "@xterm/headless": "^6.0.0",
    "prettier": "^3.6.0",
    "semver": "7.7.4",
    "solid-js": "1.9.12",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "seroval": "1.6.9"
  },
  "engines": {
    "node": ">=22"
  }
}
